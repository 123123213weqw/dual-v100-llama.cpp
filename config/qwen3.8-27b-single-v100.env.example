# Single-user throughput profile validated on one Tesla V100-PCIE-32GB.
MODEL=/models/Qwen3.8-27B-Q4_K_M.gguf
MMPROJ=/models/mmproj-F16.gguf
MODEL_ALIAS=qwen3.8-27b

HOST=0.0.0.0
PORT=8000
CUDA_VISIBLE_DEVICES=0

CONTEXT=262144
PARALLEL=1
BATCH=2048
UBATCH=512
SPLIT_MODE=none
MAIN_GPU=0
KV_TYPE_K=q4_0
KV_TYPE_V=q4_0

SPEC_TYPE=draft-mtp
SPEC_DRAFT_MAX=1
# `auto` keeps llama.cpp's fast single-GPU default (currently enabled).
SPEC_DRAFT_BACKEND_SAMPLING=auto
