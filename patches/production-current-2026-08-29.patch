+llama_token common_sampler_sample_from_candidates(
+        struct common_sampler * gsmpl,
+        const llama_token_data_array & candidates,
+        bool grammar_first) {
+    if (!gsmpl || candidates.size == 0) {
+        return LLAMA_TOKEN_NULL;
+    }
+
+    const auto tm = gsmpl->tm();
+
+    auto & grmr    = gsmpl->grmr;
+    auto & rbudget = gsmpl->rbudget;
+    auto & chain   = gsmpl->chain;
+    auto & cur_p   = gsmpl->cur_p;
+
+    gsmpl->cur.assign(candidates.data, candidates.data + candidates.size);
+    // The copied logits are about to be changed by penalties, biases and
+    // grammar filters, so any ordering from the source distribution is stale.
+    cur_p = { gsmpl->cur.data(), gsmpl->cur.size(), -1, false };
+
+    llama_sampler_apply(rbudget, &cur_p);
+
+    if (grammar_first && grammar_should_apply(gsmpl)) {
+        llama_sampler_apply(grmr, &cur_p);
+    }
+
+    bool has_candidate = false;
+    for (size_t i = 0; i < cur_p.size; ++i) {
+        has_candidate = has_candidate || std::isfinite(cur_p.data[i].logit);
+    }
+    if (!has_candidate) {
+        return LLAMA_TOKEN_NULL;
+    }
+
+    llama_sampler_apply(chain, &cur_p);
+
+    if (cur_p.selected < 0 || (size_t) cur_p.selected >= cur_p.size) {
+        return LLAMA_TOKEN_NULL;
+    }
+
+    const llama_token id = cur_p.data[cur_p.selected].id;
+
+    if (grammar_first || !grammar_should_apply(gsmpl)) {
+        return id;
+    }
+
+    llama_token_data       single = { id, 1.0f, 0.0f };
+    llama_token_data_array single_p = { &single, 1, -1, false };
+    llama_sampler_apply(grmr, &single_p);
+
+    if (std::isfinite(single.logit)) {
+        return id;
+    }
+
+    gsmpl->cur.assign(candidates.data, candidates.data + candidates.size);
+    cur_p = { gsmpl->cur.data(), gsmpl->cur.size(), -1, false };
+
+    llama_sampler_apply(rbudget, &cur_p);
+    if (grammar_should_apply(gsmpl)) {
+        llama_sampler_apply(grmr, &cur_p);
+    }
+
+    has_candidate = false;
+    for (size_t i = 0; i < cur_p.size; ++i) {
+        has_candidate = has_candidate || std::isfinite(cur_p.data[i].logit);
+    }
+    if (!has_candidate) {
+        return LLAMA_TOKEN_NULL;
+    }
+
+    llama_sampler_apply(chain, &cur_p);
+    if (cur_p.selected < 0 || (size_t) cur_p.selected >= cur_p.size) {
+        return LLAMA_TOKEN_NULL;
+    }
+
+    return cur_p.data[cur_p.selected].id;
+}
